# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Credenciales de Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CORS
CORS_ORIGIN=*

# Gemini (opcional): sugerencia de descripción de oficios. Crea la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Contraseñas de las cuentas de demo que crea `npm run seed`. Cambia estos valores: este archivo es público.
SEED_PASSWORD_WILMER=cambia-esta-clave-1
SEED_PASSWORD_EDSON=cambia-esta-clave-2
SEED_PASSWORD_ADMIN=cambia-esta-clave-3
