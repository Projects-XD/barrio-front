{
  "expo": {
    "name": "Barrio",
    "slug": "barrio-front",
    "scheme": "barrio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/logo-barrio.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.barrio.app",
      "adaptiveIcon": {
        "backgroundColor": "#132E66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic.js",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación solo para detectar tu zona al registrarte. No guardamos tu ubicación exacta."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "98455890-7b4b-4126-9f47-4d53b26646ca"
      }
    }
  }
}
