# URL base del backend API de Barrio
# - Emulador Android: http://10.0.2.2:3000/api/v1
# - Simulador iOS / Web: http://localhost:3000/api/v1
# - Celular fisico con Expo Go: usar la IP LAN del PC (ej. http://192.168.1.50:3000/api/v1).
#   "localhost" apunta al propio celular y las peticiones al backend fallan.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Configuración del proyecto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
